---
import Base from '../layouts/Base.astro';
---
<Base title="Hire me" description="Hire me to unlock my full potential." image="/og/hire-me.png">
  <div class="paper">
    <div class="top">
      <div class="face"><img src="/hire-me/face.png" alt="Taksh peeking over the page" /></div>
      <div class="pills">
        <div><span class="pill">Objectives</span><p>To be part of your company wherein I can ship to production on a Friday and still sleep well.</p></div>
        <div><span class="pill">Education</span></div>
      </div>
    </div>
    <p class="cta">Hire me to unlock my full potential</p>
  </div>
  <p class="real"><a href="/resume/">ok fine, here's the real resume →</a></p>
</Base>

<style>
  .paper { background: #fff; color: #111; border-radius: 6px; padding: 28px 32px 56px; aspect-ratio: 1 / 1.1; display: flex; flex-direction: column; justify-content: space-between; box-shadow: 0 8px 30px rgb(0 0 0 / 0.12); }
  .top { display: flex; gap: 28px; align-items: flex-start; }
  .face { width: 150px; flex: none; }
  .face img { width: 100%; display: block; }
  .pills { flex: 1; display: grid; gap: 22px; font-size: 12px; color: #444; }
  .pill { display: inline-block; background: #222; color: #fff; font-weight: 700; padding: 4px 16px; border-radius: 999px; font-size: 15px; }
  .pills p { margin: 8px 0 0; }
  .cta { font-size: 30px; font-weight: 600; text-align: center; margin: 0; }
  .real { text-align: center; font: 14px var(--mono); margin-top: 24px; }
</style>
