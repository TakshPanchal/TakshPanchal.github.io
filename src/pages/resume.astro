---
import Base from '../layouts/Base.astro';
---
<Base title="Resume" description="Founding engineer, 3.5+ years. Built and run Superboard.xyz end to end, serving 2.1M+ accounts." image="/og/resume.png">
  <p class="bar"><span class="label-inline">// resume</span><a href="/resume.pdf" download="Taksh_Panchal_Resume.pdf">download pdf ↓</a></p>
  <object data="/resume.pdf" type="application/pdf" aria-label="Resume PDF">
    <p><a href="/resume.pdf">Open the resume (PDF)</a></p>
  </object>
</Base>

<style>
  .bar { display: flex; justify-content: space-between; font: 13px var(--mono); color: var(--muted); margin: 0 0 12px; }
  .label-inline { color: var(--faint); }
  object { width: 100%; height: 85vh; border: 1px solid var(--line); border-radius: 8px; }
</style>
