---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const date = post.data.date.toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric' });
---
<Base title={post.data.title} description={post.data.description}>
  <article>
    <p class="meta">{date}{post.data.tags.length > 0 && <> · {post.data.tags.join(' · ')}</>}</p>
    <h1>{post.data.title}</h1>
    <p class="desc">{post.data.description}</p>
    <Content />
  </article>
  <p class="back"><a href="/#writing">← all writing</a></p>
</Base>

<style>
  .meta { font: 13px var(--mono); color: var(--faint); margin: 0 0 8px; }
  h1 { font-size: 28px; line-height: 1.2; margin: 0 0 10px; letter-spacing: -0.015em; }
  .desc { color: var(--muted); font-size: 17px; margin: 0 0 36px; }
  article :global(h2) { font-size: 19px; margin: 40px 0 8px; }
  article :global(h3) { font-size: 16px; margin: 28px 0 6px; }
  article :global(blockquote) { margin: 20px 0; padding-left: 14px; border-left: 2px solid var(--accent); color: var(--muted); }
  article :global(table) { width: 100%; border-collapse: collapse; font-size: 14px; margin: 16px 0; }
  article :global(th), article :global(td) { text-align: left; padding: 6px 8px; border-bottom: 1px solid var(--line); }
  article :global(th) { font: 12px var(--mono); color: var(--faint); }
  .back { margin-top: 48px; font: 14px var(--mono); }
  .back a { text-decoration: none; color: var(--muted); }
</style>
