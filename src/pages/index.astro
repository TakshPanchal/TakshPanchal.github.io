---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = (d: Date) => d.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });

const work = [
  { when: '2025 – now', org: 'Superboard.xyz', url: 'https://superboard.xyz', role: 'Founding Engineer', note: 'Built the platform from zero. 2.1M+ accounts, 8.46M+ user activities.' },
  { when: '2023 – 2025', org: 'Searce', url: 'https://www.searce.com', role: 'Software Engineer', note: 'Async LLM and ML document-extraction services in Python.' },
  { when: '2022', org: 'Orbitz IT Solution', url: 'https://github.com/Orbitz-IT-Solution', role: 'Android Intern', note: 'Field-sales tracking app with live location.' },
];
const stack = ['TypeScript', 'NestJS', 'PostgreSQL', 'Redis', 'BullMQ', 'Python', 'Go', 'Cloudflare', 'Fly.io', 'AWS', 'OpenTelemetry'];
---
<Base>
  <h1 class="name">Taksh Panchal</h1>
  <p class="role">Backend &amp; platform engineer · Bengaluru</p>
  <p>I build and run <a href="https://superboard.xyz">Superboard.xyz</a> as its founding engineer: the APIs, the Postgres and Redis data layer, the job queues, the cloud infrastructure and the bots trying to break all of it. Before that I built LLM and ML extraction pipelines at Searce.</p>
  <p>I like systems that stay correct under concurrency, cost less every month, and tell you what went wrong. I write about the ones I've built below.</p>

  <div class="stack">{stack.map((s) => <code>{s}</code>)}</div>

  <div class="label" id="writing">writing</div>
  <ul class="list">
    {posts.map((p) => (
      <li><a href={`/posts/${p.id}/`}>{p.data.title}</a><time>{fmt(p.data.date)}</time></li>
    ))}
  </ul>

  <div class="label">work</div>
  <ul class="work">
    {work.map((w) => (
      <li>
        <time>{w.when}</time>
        <div><a href={w.url}>{w.org}</a> <span class="muted">· {w.role}</span><br /><span class="muted">{w.note}</span></div>
      </li>
    ))}
  </ul>

  <div class="label">elsewhere</div>
  <p class="links"><a href="https://github.com/takshpanchal">github</a> · <a href="https://www.linkedin.com/in/takshpanchal">linkedin</a> · <a href="/resume.pdf">resume.pdf</a> · <a href="mailto:taksh.career@gmail.com">email</a></p>
</Base>

<style>
  .name { font-size: 22px; font-weight: 600; margin: 0; letter-spacing: -0.01em; }
  .role { font: 14px var(--mono); color: var(--muted); margin: 4px 0 24px; }
  p { color: var(--fg); }
  .stack { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 20px; }
  .stack code { font-size: 12px; color: var(--muted); }
  .list, .work { list-style: none; padding: 0; margin: 0; }
  .list li { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; padding: 10px 0; border-bottom: 1px solid var(--line); }
  .list a { text-decoration: none; }
  time { font: 13px var(--mono); color: var(--faint); white-space: nowrap; }
  .work li { display: grid; grid-template-columns: 110px 1fr; gap: 12px; padding: 8px 0; }
  .work time { padding-top: 2px; }
  .muted { color: var(--muted); font-size: 15px; }
  .links { font: 14px var(--mono); }
  @media (max-width: 480px) { .work li { grid-template-columns: 1fr; gap: 0; } }
</style>
